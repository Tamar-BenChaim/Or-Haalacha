# Copy to .env for local development. Never commit the real file.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of the store's browser origins (required)
CORS_ORIGINS=http://localhost:5173
# Browser origin of the admin app (required). Only it may call /admin routes.
ADMIN_ORIGIN=http://localhost:5174

# Number of reverse proxies in front of the server (0 locally, set per host in production)
TRUST_PROXY=0

# Rate limiting per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MongoDB connection string for a database user with the minimum required permissions (required).
# Local development can use a local MongoDB, e.g. mongodb://127.0.0.1:27017
MONGODB_URI=
# Database name, separate per environment (required), e.g. or-haalacha-dev
MONGODB_DB_NAME=or-haalacha-dev

# Tests only: an existing MongoDB to run the tests against.
# When empty, the tests start an in-memory MongoDB automatically.
MONGODB_TEST_URI=

# Admin area (see docs/decisions/0010-admin-api-auth.md)
# Comma-separated list of admin emails allowed by the server (required)
ADMIN_EMAILS=support@orhaalacha.org
# Cloudflare Access: team domain (https://<team>.cloudflareaccess.com) and the
# application audience (AUD) tag. Required in production; without them in
# development every admin token is rejected.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Development only: treat every admin request as this admin, without Cloudflare
# Access, e.g. to try the admin routes in Postman. The server refuses to start
# with it in production.
ADMIN_DEV_EMAIL=

# Added later, once chosen: payment provider, email provider, image storage
