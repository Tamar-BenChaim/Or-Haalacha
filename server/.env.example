# Copy to .env for local development. Never commit the real file.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (required)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the server (0 locally, set per host in production)
TRUST_PROXY=0

# Rate limiting per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Not used yet – added with the data layer and the admin area
# MongoDB Atlas connection string for a database user with the minimum required permissions
MONGODB_URI=
# Cloudflare Access (admin area): team domain and application audience tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Added later, once chosen: payment provider, email provider, image storage
