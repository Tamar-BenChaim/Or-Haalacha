{
  "info": {
    "name": "Or Haalacha API",
    "description": "Requests for the Or Haalacha server. Run the server locally (npm run dev) and seed sample data (npm run seed) first. See docs/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('server and database are ok', () => {",
              "  pm.expect(pm.response.json()).to.eql({ status: 'ok', database: 'ok' });",
              "});",
              "pm.test('has a request id', () => pm.response.to.have.header('X-Request-Id'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Server and database availability."
      }
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const { books } = pm.response.json();",
                  "pm.test('returns the visible sample books', () => pm.expect(books).to.have.lengthOf(4));",
                  "pm.test('prices are whole agorot', () => {",
                  "  books.forEach((book) => pm.expect(Number.isInteger(book.priceAgorot)).to.be.true);",
                  "});",
                  "pm.test('internal fields are hidden', () => {",
                  "  books.forEach((book) => pm.expect(book).to.not.have.any.keys('stock', 'hidden', 'lowStockThreshold'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "All books shown in the store, in display order."
          }
        },
        {
          "name": "Get a book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the requested book with its description', () => {",
                  "  const { book } = pm.response.json();",
                  "  pm.expect(book.slug).to.eql('or-haalacha-1');",
                  "  pm.expect(book.description).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/or-haalacha-1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "or-haalacha-1"]
            },
            "description": "A single book by its permanent address."
          }
        },
        {
          "name": "Hidden book is not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('BOOK_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/or-haalacha-5",
              "host": ["{{baseUrl}}"],
              "path": ["books", "or-haalacha-5"]
            },
            "description": "Sample volume 5 is hidden, so the store must not expose it."
          }
        },
        {
          "name": "Unknown book is not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('BOOK_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/no-such-book",
              "host": ["{{baseUrl}}"],
              "path": ["books", "no-such-book"]
            },
            "description": "A book address that does not exist."
          }
        },
        {
          "name": "Malformed address is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/Bad_Slug",
              "host": ["{{baseUrl}}"],
              "path": ["books", "Bad_Slug"]
            },
            "description": "Input validation: book addresses use lowercase letters, digits and dashes only."
          }
        }
      ]
    },
    {
      "name": "Bundles",
      "item": [
        {
          "name": "List bundles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const [bundle] = pm.response.json().bundles;",
                  "pm.test('returns the full set', () => pm.expect(bundle.slug).to.eql('full-set'));",
                  "pm.test('shows the saving', () => pm.expect(bundle.separatePriceAgorot).to.be.above(bundle.priceAgorot));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bundles",
              "host": ["{{baseUrl}}"],
              "path": ["bundles"]
            },
            "description": "Bundles such as the full set, with the price of the books bought separately."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Quote a cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const quote = pm.response.json();",
                  "pm.test('price comes from the database, not the request', () => {",
                  "  pm.expect(quote.items[0].unitPriceAgorot).to.eql(6500);",
                  "});",
                  "pm.test('subtotal', () => pm.expect(quote.subtotalAgorot).to.eql(3 * 6500));",
                  "pm.test('everything is available', () => pm.expect(quote.allAvailable).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/quote",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "quote"]
            },
            "description": "Recalculates the cart on the server. The priceAgorot sent here is ignored on purpose.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-1\",\n      \"quantity\": 2,\n      \"priceAgorot\": 1\n    },\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-2\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Quote with stock problems",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const quote = pm.response.json();",
                  "pm.test('line statuses', () => {",
                  "  pm.expect(quote.items.map((i) => i.status)).to.eql(['out_of_stock', 'unavailable', 'limited', 'out_of_stock']);",
                  "});",
                  "pm.test('not everything is available', () => pm.expect(quote.allAvailable).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/quote",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "quote"]
            },
            "description": "Volume 4 is out of stock, volume 5 is hidden, 50 copies of volume 2 exceed the sample stock, and the full set includes the out-of-stock volume 4.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-4\",\n      \"quantity\": 1\n    },\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-5\",\n      \"quantity\": 1\n    },\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-2\",\n      \"quantity\": 50\n    },\n    {\n      \"type\": \"bundle\",\n      \"slug\": \"full-set\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid quantity is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/quote",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "quote"]
            },
            "description": "Quantities must be whole numbers from 1 to 99.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"type\": \"book\",\n      \"slug\": \"or-haalacha-1\",\n      \"quantity\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Injection attempt is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/quote",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "quote"]
            },
            "description": "A MongoDB operator instead of a slug must never reach the database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"type\": \"book\",\n      \"slug\": {\n        \"$ne\": null\n      },\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Unknown route",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/no-such-route",
          "host": ["{{baseUrl}}"],
          "path": ["no-such-route"]
        },
        "description": "Any address the server does not know."
      }
    }
  ]
}
